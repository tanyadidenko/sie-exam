{
  "methodology": {
    "name": "Adaptive Learning with Spaced Repetition",
    "name_ru": "Адаптивное обучение с интервальным повторением",
    "description": "Научно обоснованный подход к подготовке к экзамену SIE, использующий интервальное повторение (SM-2) для вопросов, терминов и теории.",
    
    "learning_path": [
      {
        "phase": 1,
        "name": "Theory Study",
        "name_ru": "Изучение теории",
        "duration_days": 14,
        "activities": [
          "Читать теорию по каждой теме",
          "Изучать термины и определения",
          "Делать заметки",
          "Повторять ключевые концепции"
        ]
      },
      {
        "phase": 2,
        "name": "Practice Questions",
        "name_ru": "Практические вопросы",
        "duration_days": 21,
        "activities": [
          "Решать вопросы по темам",
          "Анализировать ошибки",
          "Повторять проблемные темы",
          "Учить термины"
        ]
      },
      {
        "phase": 3,
        "name": "Full Tests",
        "name_ru": "Полные тесты",
        "duration_days": 14,
        "activities": [
          "Проходить полные тесты (75 вопросов)",
          "Повторять ошибки",
          "Тренировать скорость",
          "Повторять термины"
        ]
      }
    ],

    "spaced_repetition": {
      "algorithm": "SM-2",
      "description": "Алгоритм интервального повторения, адаптирующий интервалы на основе результатов",
      
      "parameters": {
        "initial_interval": 1,
        "ease_factor_start": 2.5,
        "ease_factor_min": 1.3,
        "interval_multiplier": 2.5
      },

      "schedule": {
        "correct_answer": {
          "description": "Правильный ответ — увеличиваем интервал",
          "intervals": [1, 3, 7, 14, 30, 60, 90],
          "action": "Следующее повторение через N дней"
        },
        "incorrect_answer": {
          "description": "Неправильный ответ — сокращаем интервал",
          "action": "Повторить через 1 день",
          "reset_ease_factor": true
        }
      },

      "application": {
        "questions": "Вопросы повторяются на основе истории ответов",
        "terms": "Термины повторяются до полного запоминания",
        "theory_sections": "Разделы теории повторяются для закрепления"
      }
    },

    "review_schedule": {
      "daily": {
        "new_terms": 5,
        "review_terms": 20,
        "practice_questions": 20,
        "review_mistakes": 10
      },
      "weekly": {
        "full_test": 1,
        "theory_review": "Все темы за неделю",
        "weak_areas": "Фокус на слабых темах"
      },
      "monthly": {
        "comprehensive_test": 2,
        "progress_assessment": true,
        "adjust_study_plan": true
      }
    },

    "progress_tracking": {
      "metrics": [
        "total_questions_answered",
        "correct_answers",
        "accuracy_percentage",
        "terms_learned",
        "theory_sections_completed",
        "streak_days",
        "xp_points",
        "level"
      ],
      "milestones": [
        {
          "name": "Theory Complete",
          "name_ru": "Теория изучена",
          "condition": "all_theory_sections_read"
        },
        {
          "name": "Terms Master",
          "name_ru": "Термины выучены",
          "condition": "all_terms_learned"
        },
        {
          "name": "Practice Ready",
          "name_ru": "Готов к практике",
          "condition": "100_questions_answered"
        },
        {
          "name": "Exam Ready",
          "name_ru": "Готов к экзамену",
          "condition": "3_consecutive_tests_70_percent"
        }
      ]
    },

    "adaptive_difficulty": {
      "description": "Адаптивная сложность — вопросы подбираются на основе уровня знаний",
      "rules": [
        "Правильный ответ → следующий вопрос сложнее",
        "Неправильный ответ → следующий вопрос проще",
        "3 правильных подряд → переход к следующей теме",
        "2 неправильных подряд → повторение текущей темы"
      ]
    }
  }
}
